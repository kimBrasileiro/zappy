// Platform-level health monitoring (AI providers, DB, queue) — intentionally
// not tenant-scoped, no company_id on either table (matches spec).
model HealthStatus {
  service     String   @id
  serviceType String   @map("service_type") // ai_provider | database | queue | integration
  status      String   @default("up") // up | degraded | down
  latencyMs   Int?     @map("latency_ms")
  lastCheck   DateTime? @map("last_check") @db.Timestamptz(6)
  lastError   String?  @map("last_error")
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("health_status")
}

// idx_incidents_open (partial, WHERE resolved_at IS NULL) is hand-written
// directly into migrations/*_init_health_status_incidents/migration.sql —
// not expressible via @@index in schema.prisma.
model HealthIncident {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service          String
  serviceType      String    @map("service_type")
  status           String
  errorMessage     String?   @map("error_message")
  startedAt        DateTime  @map("started_at") @db.Timestamptz(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  durationMinutes  Int?      @map("duration_minutes")
  notified         Boolean   @default(false)

  @@map("health_incidents")
}
