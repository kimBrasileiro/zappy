// created_at/updated_at columns are DEFAULT now() without a NOT NULL
// constraint (matches the raw SQL in migration 001) — modeled here as
// required DateTime fields since Prisma always supplies the default on
// insert; the DB permits NULL only if a caller writes it via raw SQL.
model Company {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String   @unique
  plan                   String   @default("starter")
  status                 String   @default("active")
  config                 Json     @default("{}")
  slaConfig              Json     @default("{}") @map("sla_config")
  // Dedicated WhatsApp Business number (manual onboarding — see
  // dashboard/integracoes and lib/whatsapp/client.ts#resolveWhatsAppCredentials).
  // whatsappPhoneId being non-null is THE signal, everywhere in this
  // codebase, that this company has opted out of the shared platform
  // number: inbound routing (lib/bot/conversation.ts#resolveWhatsAppRoute)
  // short-circuits straight to this company whenever a message arrives on
  // this phone_number_id, and — just as important — a company with this
  // set is excluded from the shared number's name-matching directory and
  // NEVER falls back to shared-number sending even if its own token is
  // broken. Two identities must never blend on one WhatsApp thread.
  // @unique: Postgres allows any number of NULL rows under a unique index
  // (every company that hasn't connected a dedicated number), but guarantees
  // no two companies can ever hold the SAME phone_number_id — without this,
  // a second signup submitting an id it merely has Graph API read access to
  // (e.g. an agency managing several clients' WABAs) would make inbound
  // routing's `findFirst({ where: { whatsappPhoneId } })` pick one company
  // non-deterministically, silently hijacking/blending another tenant's
  // conversations. connectWhatsAppNumber (dashboard/integracoes/actions.ts)
  // also pre-checks this for a friendly error, but THIS constraint is what
  // actually closes the race, not the pre-check alone.
  whatsappPhoneId        String?  @unique @map("whatsapp_phone_id")
  whatsappTokenEncrypted String?  @map("whatsapp_token_encrypted")
  // Display-only (like googleCalendarConnectedEmail below) — the human-
  // readable number Meta returned when the token was validated at connect
  // time, so the integrations page can show it without decrypting anything.
  whatsappConnectedNumber String? @map("whatsapp_connected_number")
  whatsappConnectedAt     DateTime? @map("whatsapp_connected_at") @db.Timestamptz(6)
  // Hostnames (no protocol/www/port, see lib/domains.ts#normalizeDomain) the
  // widget script is allowed to be embedded on. Empty = not configured yet =
  // open to any origin (see guardrails.ts#checkOrigin) — a fresh signup can
  // still test the widget anywhere before locking it down.
  allowedDomains         String[] @default([]) @map("allowed_domains")
  // Stripe billing (lib/stripe/client.ts, api/webhooks/stripe). subscriptionStatus
  // mirrors Stripe's own subscription.status string verbatim (trialing/active/
  // past_due/canceled/incomplete) for billing display — the existing `status`
  // field above stays the simple active/inactive gate checkCompanyActive already
  // uses, kept in sync by the webhook rather than repurposed.
  stripeCustomerId       String?  @map("stripe_customer_id")
  stripeSubscriptionId   String?  @map("stripe_subscription_id")
  subscriptionStatus     String?  @map("subscription_status")
  // A "trialing" subscription can exist with zero payment method attached —
  // Stripe never forces one just because a trial started (see
  // lib/stripe/client.ts#startTrialSubscription's own comment on why the
  // subscription's pending_setup_intent is always null for a trial). This is
  // what lets lib/stripe/client.ts#isBillingActive tell "real trial, card on
  // file" apart from "subscription exists but nobody's finished checkout
  // yet" — kept in sync by api/webhooks/stripe/route.ts on every
  // subscription event (derived straight from Stripe's own
  // default_payment_method) AND immediately on setup_intent.succeeded,
  // rather than requiring a live Stripe call on every dashboard request.
  hasPaymentMethod       Boolean  @default(false) @map("has_payment_method")
  // Mirrors Stripe's Subscription.cancel_at_period_end — without this, the
  // DB has no record at all of "will cancel at period end" (Stripe's status
  // string itself doesn't change until the period actually ends), which
  // meant the only place that ever showed it was a live Stripe API call on
  // every dashboard/billing page load. Kept in sync from both directions:
  // dashboard/billing/actions.ts writes it immediately on cancel/reactivate,
  // the webhook (api/webhooks/stripe/route.ts) re-syncs it on every
  // subscription event regardless of where the change came from.
  cancelAtPeriodEnd      Boolean  @default(false) @map("cancel_at_period_end")
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  // Google Calendar integration (lib/google-calendar/client.ts,
  // app/api/integrations/google-calendar/*) — all nullable, 100% opt-in.
  // refresh_token is encrypted at rest via lib/crypto.ts, same reasoning as
  // whatsappTokenEncrypted above but actually wired up. connectedEmail is
  // display-only, shown on the dashboard integrations page so whoever's
  // looking knows which Google account is connected without decrypting
  // anything.
  googleCalendarId                    String?   @map("google_calendar_id")
  googleCalendarRefreshTokenEncrypted String?   @map("google_calendar_refresh_token_encrypted")
  googleCalendarConnectedEmail        String?   @map("google_calendar_connected_email")
  googleCalendarConnectedAt           DateTime? @map("google_calendar_connected_at") @db.Timestamptz(6)
  // Self-reported at signup/onboarding (see lib/business-types.ts for the
  // fixed set of keys) — nullable only because every company created before
  // this field existed has no value to backfill; new signups always set it.
  // Exists purely for GTM segmentation (admin/companies, future reporting),
  // not read anywhere in the bot/booking logic itself.
  businessType           String?  @map("business_type")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  users              User[]
  customers          Customer[]
  tickets            Ticket[]
  responseTemplates  ResponseTemplate[]
  auditLogs          AuditLog[]
  services           Service[]
  bookings           Booking[]
  faqs               Faq[]
  whatsappRoutes     WhatsAppRoute[]
  staffAbsences      StaffAbsence[]
  leads              Lead[]
  // Sports-court modality (sports.prisma) — empty for every other company.
  courts               Court[]
  sportClasses         SportClass[]
  classEnrollments     ClassEnrollment[]
  customerSportLevels  CustomerSportLevel[]
  courtReservations    CourtReservation[]

  @@map("companies")
}
