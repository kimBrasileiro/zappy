# Database (Aurora PostgreSQL Serverless v2, pgvector enabled via migration 004)
DATABASE_URL="postgresql://app_user:password@localhost:5432/chat_ia?schema=public"

# Redis (ElastiCache in prod, local Redis in dev — used by BullMQ starting phase 2)
REDIS_URL="redis://localhost:6379"

# AI providers (populated out-of-band, never committed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# WhatsApp Cloud API (Meta) — token stored encrypted at rest in companies.whatsapp_token_encrypted
WHATSAPP_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=

# Email
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=