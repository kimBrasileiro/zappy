// `embedding` is Unsupported("vector(1536)") — Prisma Client cannot type or
// query this column. All reads/writes of embeddings go through raw SQL
// (implemented alongside semantic search in a later phase), e.g.:
//   write: prisma.$executeRaw`UPDATE kb_articles SET embedding = ${vec}::vector WHERE id = ${id}`
//   read:  prisma.$queryRaw`SELECT id, title, content, 1 - (embedding <=> ${vec}::vector) AS similarity
//                            FROM kb_articles WHERE company_id = ${companyId}
//                            ORDER BY embedding <=> ${vec}::vector LIMIT ${k}`
// The `CREATE EXTENSION vector` statement and the ivfflat index are hand-added
// to migrations/*_init_kb_articles_pgvector/migration.sql — Prisma cannot
// express either in schema.prisma.
model KbArticle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  title     String
  content   String
  category  String?

  embedding Unsupported("vector(1536)")?

  isPublic  Boolean  @default(true) @map("is_public")
  active    Boolean  @default(true)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser  User?   @relation("KbArticleCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@map("kb_articles")
}
