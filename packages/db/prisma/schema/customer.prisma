model Customer {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String?
  email         String?
  phone         String? // WhatsApp identifier
  externalId    String?   @map("external_id") // id in the client's own system (CRM, etc.)
  // Free-text preferences/notes typed by the company's own team on the
  // client profile page (dashboard/clients) — e.g. "alérgica a esmalte X",
  // "prefere corte com a Ana". Never written by the bot or the customer
  // themselves, purely an internal note.
  notes         String?
  metadata      Json      @default("{}")
  gdprDeletedAt DateTime? @map("gdpr_deleted_at") @db.Timestamptz(6) // LGPD/GDPR anonymization marker
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  bookings       Booking[]
  whatsappRoutes WhatsAppRoute[]

  // Phase 2: crmContactId (HubSpot/Salesforce/Pipedrive OAuth2 sync) attaches
  // here without a destructive migration.

  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, phone])
  @@map("customers")
}
