model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  priceCents      Int      @map("price_cents")
  // 'auto' — the bot confirms the booking directly with the customer.
  // 'manual' — the bot tells the customer someone from the team will call to
  // confirm; the slot is still reserved (locks availability the same way)
  // but requires human follow-up, e.g. for services needing an assessment
  // before confirming.
  bookingMode     String   @default("auto") @map("booking_mode")
  // Per-service business hours, same shape as Company.config.businessHours
  // (Record<"sun"|"mon"|...,  [open, close] | null>). Null means "use the
  // company's default hours" — most services don't need their own schedule,
  // only ones with different hours than the rest of the business (e.g. a
  // service only offered on weekday mornings).
  businessHours   Json?    @map("business_hours")
  // When true, the service is bookable any day of the week at any time —
  // businessHours (own or the company's) is ignored entirely by
  // checkAvailability. Mutually exclusive with businessHours in the
  // dashboard form; the flag wins if both are somehow set.
  is24h           Boolean  @default(false) @map("is_24h")
  // Cancellation policy — purely informational for now (quoted to the
  // customer, not enforced by an actual charge anywhere in this codebase;
  // there's no payment collection on bookings at all yet). 0 hours means "no
  // minimum notice required"; 0 cents means "no fee".
  cancellationNoticeHours Int @default(0) @map("cancellation_notice_hours")
  cancellationFeeCents    Int @default(0) @map("cancellation_fee_cents")
  // Just names, no separate Staff entity — who performs this service, for
  // conflict checking (see lib/bot/services.ts#checkAvailability/
  // createBooking, which switch from per-service to per-staff-member
  // availability the moment this is non-empty) and so the bot can ask which
  // person the customer wants, or auto-allocate whoever's free. Empty means
  // "no staff concept" — a single generic provider, the original behavior,
  // fully unaffected.
  staffNames      String[] @default([]) @map("staff_names")
  active          Boolean  @default(true)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("ServiceCreatedBy", fields: [createdBy], references: [id])
  bookings      Booking[]
  staffAbsences StaffAbsence[]

  @@index([companyId])
  @@map("services")
}
