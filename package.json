{
  "name": "zappy",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "pnpm --filter @zappy/eval eval",
    "db:generate": "pnpm --filter @zappy/db db:generate",
    "db:migrate": "pnpm --filter @zappy/db db:migrate",
    "db:migrate:prod": "pnpm --filter @zappy/db db:migrate:prod",
    "db:migrate:status": "pnpm --filter @zappy/db db:migrate:status",
    "db:migrate:rollback": "pnpm --filter @zappy/db db:migrate:rollback",
    "db:migration:new": "pnpm --filter @zappy/db db:migration:new",
    "db:seed": "pnpm --filter @zappy/db db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@prisma/client", "@prisma/engines", "prisma"]
  }
}
