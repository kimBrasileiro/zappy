model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  priceCents      Int      @map("price_cents")
  // 'auto' — the bot confirms the booking directly with the customer.
  // 'manual' — the bot tells the customer someone from the team will call to
  // confirm; the slot is still reserved (locks availability the same way)
  // but requires human follow-up, e.g. for services needing an assessment
  // before confirming.
  bookingMode     String   @default("auto") @map("booking_mode")
  // Per-service business hours, same shape as Company.config.businessHours
  // (Record<"sun"|"mon"|...,  [open, close] | null>). Null means "use the
  // company's default hours" — most services don't need their own schedule,
  // only ones with different hours than the rest of the business (e.g. a
  // service only offered on weekday mornings).
  businessHours   Json?    @map("business_hours")
  // When true, the service is bookable any day of the week at any time —
  // businessHours (own or the company's) is ignored entirely by
  // checkAvailability. Mutually exclusive with businessHours in the
  // dashboard form; the flag wins if both are somehow set.
  is24h           Boolean  @default(false) @map("is_24h")
  // Cancellation policy — purely informational for now (quoted to the
  // customer, not enforced by an actual charge anywhere in this codebase;
  // there's no payment collection on bookings at all yet). 0 hours means "no
  // minimum notice required"; 0 cents means "no fee".
  cancellationNoticeHours Int @default(0) @map("cancellation_notice_hours")
  cancellationFeeCents    Int @default(0) @map("cancellation_fee_cents")
  // Just names, no separate Staff entity — who performs this service, for
  // conflict checking (see lib/bot/services.ts#checkAvailability/
  // createBooking, which switch from per-service to per-staff-member
  // availability the moment this is non-empty) and so the bot can ask which
  // person the customer wants, or auto-allocate whoever's free. Empty means
  // "no staff concept" — a single generic provider, the original behavior,
  // fully unaffected.
  staffNames      String[] @default([]) @map("staff_names")
  // Per-staff-member duration override, Record<staffName, minutes> — a
  // service can genuinely take different amounts of time depending on who
  // performs it (e.g. "Corte" is 30min with Bruno, 45min with Ana). A name
  // absent from this map falls back to durationMinutes above (the common
  // case: most staff share the service's base duration, only outliers need
  // an entry here). Keyed by the exact spelling in staffNames — see
  // lib/bot/services.ts#resolveStaffDuration.
  staffDurations  Json     @default("{}") @map("staff_durations")
  // Free-text, company-defined — never a fixed enum per vertical (a
  // barbearia's "Cabelo"/"Barba" and a pet shop's "Banho e Tosa" are just
  // different strings the same field holds). Used to group the dashboard
  // list and the public booking form's service picker; a service with no
  // category falls into an "Outros" bucket in both, not an error.
  category        String?
  // Public URL of an uploaded photo (GCS, see lib/storage.ts) — shown on the
  // dashboard service card and the public booking form's service picker.
  // Null just means no photo was uploaded, same non-event as no category.
  photoUrl        String?  @map("photo_url")
  // Price/duration variations under one service — a pet's bath priced by
  // size, a haircut by hair length, or genuinely anything else a company
  // wants to label itself: [{label, priceCents, durationMinutes}, ...].
  // Empty (the default) means "no variants" — the base priceCents/
  // durationMinutes above apply exactly as they did before this existed,
  // same zero-migration-risk pattern as staffNames: [] meaning "no staff
  // concept". See lib/bot/services.ts#resolveVariant, the single place that
  // reads this alongside the base fields.
  variants        Json     @default("[]")
  active          Boolean  @default(true)
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("ServiceCreatedBy", fields: [createdBy], references: [id])
  bookings      Booking[]
  staffAbsences StaffAbsence[]

  @@index([companyId])
  @@map("services")
}
