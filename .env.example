# Database (Aurora PostgreSQL Serverless v2, pgvector enabled via migration 004)
DATABASE_URL="postgresql://app_user:password@localhost:5432/zappigo?schema=public"

# Better Auth session/cookie signing key — without this, better-auth falls
# back to an insecure auto-generated secret that can change across process
# restarts, silently invalidating every existing session/cookie. Required in
# every environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Redis (ElastiCache in prod, local Redis in dev — used by BullMQ starting phase 2)
REDIS_URL="redis://localhost:6379"

# AI providers (populated out-of-band, never committed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# WhatsApp Cloud API (Meta) — the default shared platform-wide number,
# routes to the right company via a "Z:<slug>" prefix in the message text
# (see lib/bot/conversation.ts#resolveWhatsAppRoute). A company can also
# connect its own dedicated number instead (dashboard/integracoes ->
# WhatsApp próprio) — stored encrypted in companies.whatsapp_token_encrypted,
# keyed by WHATSAPP_TOKEN_ENCRYPTION_KEY below (lib/crypto.ts). Generate a
# real key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_NUMBER=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Google Calendar integration (per-company, opt-in — apps/web/lib/google-
# calendar/client.ts, apps/web/app/dashboard/integracoes). Its own OAuth
# Client in Google Cloud Console, separate from GOOGLE_CLIENT_ID/SECRET above
# (login) — needs the Calendar API enabled + calendar scope added on the
# OAuth consent screen, and this redirect URI registered on the client:
# https://<app-url>/api/integrations/google-calendar/callback
# Generate the encryption key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Email — notifies a company's admins when a booking is created or a
# conversation is escalated (see lib/notifications.ts). Sandbox sender
# (onboarding@resend.dev) works with no domain verification for local dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Zappigo <onboarding@resend.dev>"

# Stripe billing — 7-day free trial, card collected at signup (see
# lib/stripe/client.ts, app/(auth)/signup/actions.ts). Absent entirely =
# signup falls back to the pre-billing flow (no plan, no card) — this is
# what keeps local dev working without a Stripe account. Price ids are
# created in the Stripe dashboard once there's an account, matching the 3
# tiers on the marketing page (marketing-home.tsx#PRICING).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_WHATSAPP_PROPRIO=
STRIPE_PRICE_INTEGRACAO=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET=

# Site-wide default locale (i18n/request.ts) — 'pt' (default), 'es', or
# 'en'. A visitor's explicit switch (NEXT_LOCALE cookie, see
# locale-switcher.tsx) always wins; this only picks what a first-time
# visitor sees. Lets a separately deployed instance on its own domain
# (e.g. a Spain deployment) default to Spanish site-wide with no code
# change — leave unset for the pt-BR default.
DEFAULT_LOCALE=

# Marketing-page pricing (lib/pricing.ts) — deployment config, NOT part of
# the translated messages/*.json: switching the UI language must never
# change what a customer is actually charged, but a separately deployed
# instance with its own Stripe account/currency (e.g. a EUR-billing Spain
# deployment) needs its own numbers here, matching whatever
# STRIPE_PRICE_BASICO above actually charges in that account. NEXT_PUBLIC_-
# prefixed on purpose — lib/pricing.ts is imported by client components too
# (signup/onboarding show the price in the browser); a plain server-side var
# here reads as undefined in the client bundle regardless of its real
# runtime value. Leave all unset for this codebase's original R$19 BRL price.
NEXT_PUBLIC_PRICING_CURRENCY_SYMBOL=
NEXT_PUBLIC_PRICING_CURRENCY_CODE=
NEXT_PUBLIC_PRICING_AMOUNT_FREE=
NEXT_PUBLIC_PRICING_AMOUNT_BASICO=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=