# Copy to terraform.tfvars (gitignored) and fill in.
# Can be the SAME GCP project as staging (resources are name-prefixed
# "zappy-production-*" vs "zappy-staging-*" and fully isolated from each
# other) or a separate project for stronger blast-radius isolation — either
# works, this module doesn't assume either way.

project_id  = "your-gcp-project-id"
github_repo = "kimBrasileiro/zappy"

# Leave the two *_image vars unset (placeholder default) for the very first
# `terraform apply` — see ../../README.md step 3.

# app_url = "https://app.suaempresa.com"

# stripe_publishable_key = "pk_live_..."
# google_client_id       = "....apps.googleusercontent.com"

# resend_from_email        = "Zappy <onboarding@suaempresa.com>"
# whatsapp_phone_number_id = "123456789012345"
# whatsapp_number          = "+5511999999999"
